diff --git a/winpr/libwinpr/synch/event.c b/winpr/libwinpr/synch/event.c
--- a/winpr/libwinpr/synch/event.c
+++ b/winpr/libwinpr/synch/event.c
@@ -208,12 +208,36 @@
 WINPR_ATTR_NODISCARD
 static int EventGetFd(HANDLE handle)
 {
-	WINPR_EVENT* event = (WINPR_EVENT*)handle;
-
-	if (!EventIsHandled(handle))
-		return -1;
-
-	return event->impl.fds[0];
+    WINPR_EVENT* event = (WINPR_EVENT*)handle;
+    if (!EventIsHandled(handle))
+        return -1;
+#ifdef __3DS__
+    if (!event->bAttached)
+    {
+        /* Prevent idle events from consuming two SOC sockets each.
+         * Materialize only when a WinPR wait actually polls this object. */
+        LightLock_Lock(&event->o3ds_event_lock);
+        if (event->impl.fds[0] < 0)
+        {
+            if (!winpr_event_init(&event->impl))
+            {
+                LightLock_Unlock(&event->o3ds_event_lock);
+                return -1;
+            }
+            if (event->o3ds_event_signaled &&
+                !winpr_event_set(&event->impl))
+            {
+                winpr_event_uninit(&event->impl);
+                LightLock_Unlock(&event->o3ds_event_lock);
+                return -1;
+            }
+        }
+        const int fd = event->impl.fds[0];
+        LightLock_Unlock(&event->o3ds_event_lock);
+        return fd;
+    }
+#endif
+    return event->impl.fds[0];
 }
 
 static BOOL EventCloseHandle_(WINPR_EVENT* event)
@@ -304,6 +328,11 @@
 	if (!event->bManualReset)
 		WLog_ERR(TAG, "auto-reset events not yet implemented");
 
+#ifdef __3DS__
+    /* Regular events need no SOC sockets until first wait. */
+    LightLock_Init(&event->o3ds_event_lock);
+    event->o3ds_event_signaled = bInitialState;
+#else
 	if (!winpr_event_init(&event->impl))
 		goto fail;
 
@@ -312,6 +341,7 @@
 		if (!SetEvent(event))
 			goto fail;
 	}
+#endif
 
 #if defined(WITH_DEBUG_EVENTS)
 	event->create_stack = winpr_backtrace(20);
@@ -403,6 +433,22 @@
 	}
 
 	event = (WINPR_EVENT*)Object;
+#ifdef __3DS__
+    if (!event->bAttached)
+    {
+        LightLock_Lock(&event->o3ds_event_lock);
+        BOOL rc = TRUE;
+        if (!event->o3ds_event_signaled)
+        {
+            if (event->impl.fds[0] >= 0)
+                rc = winpr_event_set(&event->impl);
+            if (rc)
+                event->o3ds_event_signaled = TRUE;
+        }
+        LightLock_Unlock(&event->o3ds_event_lock);
+        return rc;
+    }
+#endif
 	return winpr_event_set(&event->impl);
 }
 
@@ -420,6 +466,19 @@
 	}
 
 	event = (WINPR_EVENT*)Object;
+#ifdef __3DS__
+    if (!event->bAttached)
+    {
+        LightLock_Lock(&event->o3ds_event_lock);
+        BOOL rc = TRUE;
+        if (event->impl.fds[0] >= 0)
+            rc = winpr_event_reset(&event->impl);
+        if (rc)
+            event->o3ds_event_signaled = FALSE;
+        LightLock_Unlock(&event->o3ds_event_lock);
+        return rc;
+    }
+#endif
 	return winpr_event_reset(&event->impl);
 }
 
diff --git a/winpr/libwinpr/synch/event.h b/winpr/libwinpr/synch/event.h
--- a/winpr/libwinpr/synch/event.h
+++ b/winpr/libwinpr/synch/event.h
@@ -22,6 +22,9 @@
 #include "../handle/handle.h"
 
 #include <winpr/config.h>
+#ifdef __3DS__
+#include <3ds/synchronization.h>
+#endif
 
 #ifdef WINPR_HAVE_SYS_EVENTFD_H
 #include <sys/eventfd.h>
@@ -41,6 +44,12 @@
 	WINPR_EVENT_IMPL impl;
 	BOOL bAttached;
 	BOOL bManualReset;
+#ifdef __3DS__
+    /* Ordinary WinPR events are materialized only when a select/poll wait
+     * requests their socket FD. Attached descriptor events are unaffected. */
+    LightLock o3ds_event_lock;
+    BOOL o3ds_event_signaled;
+#endif
 	char* name;
 #if defined(WITH_DEBUG_EVENTS)
 	void* create_stack;
