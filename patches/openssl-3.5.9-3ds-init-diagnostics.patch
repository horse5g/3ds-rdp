+static unsigned int horizon_crypto_init_stage;
+unsigned int ossl_3ds_crypto_init_stage(void)
+{
+    return horizon_crypto_init_stage;
+}
+#define HORIZON_INIT_STAGE(n) (horizon_crypto_init_stage = (n))
+#define HORIZON_INIT_STAGE_IF_NONE(n) do { \
+    if (horizon_crypto_init_stage == 0) horizon_crypto_init_stage = (n); \
+} while (0)
+#else
+#define HORIZON_INIT_STAGE(n) ((void)0)
+#define HORIZON_INIT_STAGE_IF_NONE(n) ((void)0)
+#endif
+
+static CRYPTO_ONCE base = CRYPTO_ONCE_STATIC_INIT;
 static int base_inited = 0;
 DEFINE_RUN_ONCE_STATIC(ossl_init_base)
 {
@@ -63,17 +79,23 @@
     ossl_malloc_setup_failures();
 #endif
 
-    if ((optsdone_lock = CRYPTO_THREAD_lock_new()) == NULL
