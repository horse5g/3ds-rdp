+        HORIZON_INIT_STAGE_IF_NONE(4); /* pthread_once / base init */
+        return 0;
+    }
 
     if (opts & OPENSSL_INIT_BASE_ONLY)
         return 1;
@@ -551,8 +575,10 @@
      * without lockless CRYPTO_atomic_load
