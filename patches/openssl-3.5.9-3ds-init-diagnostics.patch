+    }
+
+    if (!CRYPTO_THREAD_init_local(&in_init_config_local, NULL)) {
+        HORIZON_INIT_STAGE(3); /* configuration TLS key */
+        goto err;
+    }
 
     base_inited = 1;
     return 1;
