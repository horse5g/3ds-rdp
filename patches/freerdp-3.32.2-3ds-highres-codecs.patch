diff --git a/libfreerdp/common/settings.c b/libfreerdp/common/settings.c
--- a/libfreerdp/common/settings.c
+++ b/libfreerdp/common/settings.c
@@ -2024,5 +2024,16 @@ UINT32 freerdp_settings_get_codecs_flags(const rdpSettings* settings)
 		flags &= (uint32_t)~FREERDP_CODEC_NSCODEC;
 	}
+#ifdef __3DS__
+	/* An original 3DS cannot reserve the PLANAR decoder's 18 bytes per
+	 * source pixel before TCP connect. At 1280x720 that is 16.6 MiB,
+	 * and at 1920x1080 it is 37.3 MiB, BEFORE the GDI framebuffer.
+	 * Prefer ordinary bitmap/NSCodec/RemoteFX at higher resolutions.
+	 * This is an O3DS resource policy, not a TLS/security fallback.
+	 * The server may still choose a codec this reduced build cannot
+	 * render; native hardware testing is required. */
+	if (settings->DesktopWidth >= 800 || settings->DesktopHeight >= 480)
+		flags &= (uint32_t)~(FREERDP_CODEC_PLANAR | FREERDP_CODEC_PROGRESSIVE);
+#endif
 	/*TODO: check other codecs flags */
 	return flags;
 }
