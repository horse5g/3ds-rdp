 #include "utils.h"
 #include "timer.h"
 
+#ifdef __3DS__
+#include <3ds/svc.h>
+#include <3ds/thread.h>
+#include "rdp_pthread_tsd.h"
+
+/* O3DS: keep native timer diagnostic state after context cleanup. */
+static unsigned int o3ds_timer_init_stage;
+static unsigned int o3ds_timer_priority;
+static unsigned int o3ds_timer_threads_used;
+static unsigned int o3ds_timer_threads_max;
+static unsigned int o3ds_timer_stack_alloc_ok;
+unsigned int freerdp_3ds_timer_init_stage(void) { return o3ds_timer_init_stage; }
+void freerdp_3ds_timer_thread_diag(unsigned int* priority,
+                                  unsigned int* threads_used,
+                                  unsigned int* threads_max,
+                                  unsigned int* stack_alloc_ok)
+{
+    if (priority) *priority = o3ds_timer_priority;
+    if (threads_used) *threads_used = o3ds_timer_threads_used;
+    if (threads_max) *threads_max = o3ds_timer_threads_max;
+    if (stack_alloc_ok) *stack_alloc_ok = o3ds_timer_stack_alloc_ok;
+}
+#define O3DS_TIMER_STAGE(value) (o3ds_timer_init_stage = (value))
+#define O3DS_TIMER_STACK_SIZE (64u * 1024u)
+
+/* Give the UI/connect thread scheduling precedence over the timer worker.
+ * Horizon priorities have inverse ordering: larger = lower priority. */
+static s32 o3ds_timer_thread_priority(void)
+{
+    s32 prio = 0x30;
+    if (R_FAILED(svcGetThreadPriority(&prio, CUR_THREAD_HANDLE)))
+        prio = 0x30;
+    if (prio < 0x18) prio = 0x18;
+    return prio < 0x3F ? prio + 1 : 0x3F;
+}
+
+/* Only on native thread creation failure; advisory heap check is not
+ * proof that the thread's actual stack and TLS allocations can succeed. */
+static void o3ds_timer_record_thread_failure(void)
+{
+    Handle limit = 0;
+    ResourceLimitType kind = RESLIMIT_THREAD;
+    s64 used = -1, max = -1;
+    if (R_SUCCEEDED(svcGetResourceLimit(&limit, CUR_PROCESS_HANDLE))) {
+        (void)svcGetResourceLimitCurrentValues(&used, limit, &kind, 1);
+        (void)svcGetResourceLimitLimitValues(&max, limit, &kind, 1);
+        svcCloseHandle(limit);
+    }
+    o3ds_timer_threads_used = used < 0 ? 0xFFFFu : (unsigned int)used;
+    o3ds_timer_threads_max = max < 0 ? 0xFFFFu : (unsigned int)max;
+    void* probe = malloc(O3DS_TIMER_STACK_SIZE + 4096u);
+    o3ds_timer_stack_alloc_ok = probe != NULL;
+    free(probe);
+}
+#else
+#define O3DS_TIMER_STAGE(value) ((void)0)
+#endif
+
 #if !defined(EMSCRIPTEN)
 #define FREERDP_TIMER_SUPPORTED
 #endif
