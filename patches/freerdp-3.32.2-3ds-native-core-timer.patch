diff --git a/libfreerdp/core/timer.c b/libfreerdp/core/timer.c
--- a/libfreerdp/core/timer.c
+++ b/libfreerdp/core/timer.c
@@ -27,7 +27,33 @@
 #include "utils.h"
 #include "timer.h"
 
-#if !defined(EMSCRIPTEN)
+/* O3DS diagnostic: keep timer constructor stage after a failed cleanup.
+ * The base O3DS client has no users of the optional timer callback API.
+ * Until WinPR's SOC socket-backed wait loop is robust, don't start a timer
+ * worker that can block FreeRDP context destruction indefinitely. */
+#ifdef __3DS__
+static unsigned int o3ds_timer_init_stage;
+unsigned int freerdp_3ds_timer_init_stage(void)
+{
+    return o3ds_timer_init_stage;
+}
+/* Retain ABI used by opt-in app diagnostics (not a failing T5 anymore). */
+void freerdp_3ds_timer_thread_diag(unsigned int* priority,
+                                  unsigned int* threads_used,
+                                  unsigned int* threads_max,
+                                  unsigned int* stack_alloc_ok)
+{
+    if (priority) *priority = 0;
+    if (threads_used) *threads_used = 0xFFFFu;
+    if (threads_max) *threads_max = 0xFFFFu;
+    if (stack_alloc_ok) *stack_alloc_ok = 0;
+}
+#define O3DS_TIMER_STAGE(n) (o3ds_timer_init_stage = (n))
+#else
+#define O3DS_TIMER_STAGE(n) ((void)0)
+#endif
+
+#if !defined(EMSCRIPTEN) && !defined(__3DS__)
 #define FREERDP_TIMER_SUPPORTED
 #endif
 #define TAG FREERDP_TAG("timer")
@@ -267,11 +293,13 @@
 FreeRDPTimer* freerdp_timer_new(rdpRdp* rdp)
 {
 	WINPR_ASSERT(rdp);
+	O3DS_TIMER_STAGE(1);
 	FreeRDPTimer* timer = calloc(1, sizeof(FreeRDPTimer));
 	if (!timer)
 		return nullptr;
 	timer->rdp = rdp;
 
+	O3DS_TIMER_STAGE(2);
 	timer->entries = ArrayList_New(TRUE);
 	if (!timer->entries)
 		goto fail;
@@ -283,10 +311,13 @@
 		obj->fnObjectFree = free;
 	}
 
+#if !defined(__3DS__)
 	timer->event = CreateEventA(nullptr, TRUE, FALSE, nullptr);
 	if (!timer->event)
 		goto fail;
+#endif
 
+	O3DS_TIMER_STAGE(4); /* one event for compatibility with event-handle list */
 	timer->mainevent = CreateEventA(nullptr, TRUE, FALSE, nullptr);
 	if (!timer->mainevent)
 		goto fail;
@@ -297,6 +328,7 @@
 	if (!timer->thread)
 		goto fail;
 #endif
+	O3DS_TIMER_STAGE(6); /* no background worker or unbounded join on 3DS */
 	return timer;
 
 fail:
@@ -340,7 +372,8 @@
 	(void)ResetEvent(timer->mainevent);
 	uint64_t now = winpr_GetTickCount64NS();
 	bool rc = ArrayList_ForEach(timer->entries, runExpiredTimerOnMainloop, &now);
-	(void)SetEvent(timer->event); // Trigger a wakeup of timer thread to reschedule
+	if (timer->event)
+		(void)SetEvent(timer->event); // Trigger worker on platforms with one
 	ArrayList_Unlock(timer->entries);
 	return rc;
 }
