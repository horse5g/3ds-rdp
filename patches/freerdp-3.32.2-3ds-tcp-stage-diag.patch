+extern void freerdp_3ds_tcp_checkpoint(unsigned int step, int system_errno,
+                                      unsigned int winpr_error)
+    __attribute__((weak));
+#define O3DS_TCP_STEP(n, winpr_error) do { \
+    if (freerdp_3ds_tcp_checkpoint) \
+        freerdp_3ds_tcp_checkpoint((n), errno, (unsigned int)(winpr_error)); \
+} while (0)
+#else
+#define O3DS_TCP_STEP(n, winpr_error) ((void)0)
+#endif
