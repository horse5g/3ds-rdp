+#if defined(__3DS__)
+/*
+ * Horizon entropy provider for OpenSSL's default DRBG.
+ * libctru documents PS_GenerateRandomBytes as cryptographically secure.
+ * Never fall back to uninitialized /dev/urandom, clocks, or timestamps.
+ * Keep requests small to bound individual PS IPC buffer sizes.
+ */
+#include <3ds.h>
+#include <openssl/crypto.h>
+#include "crypto/rand_pool.h"
+#include "prov/seeding.h"
+
+#define OSSL_3DS_PS_CHUNK 32
+
+/* Diagnostic metadata only: never store PS-generated random output. */
+typedef struct {
+    unsigned int entropy_calls, entropy_successes;
+    unsigned int nonce_calls, nonce_successes;
+    unsigned int last_failure_stage, last_ps_result;
+    unsigned int last_entropy_request, last_nonce_capacity;
+} OSSL_3DS_PS_RNG_DIAG;
+
+static OSSL_3DS_PS_RNG_DIAG ps_rng_diag;
+
+void ossl_3ds_ps_rng_snapshot(OSSL_3DS_PS_RNG_DIAG *out)
+{
+    if (out != NULL)
+        *out = ps_rng_diag;
+}
+
+int ossl_rand_pool_init(void)
+{
+    return 1;
+}
+
+void ossl_rand_pool_cleanup(void)
+{
+}
+
+void ossl_rand_pool_keep_random_devices_open(int keep)
+{
+    (void)keep;
+}
+
+size_t ossl_pool_acquire_entropy(RAND_POOL *pool)
+{
+    size_t remaining = ossl_rand_pool_bytes_needed(pool, 1);
+    size_t entropy;
+    Result rc;
+
+    ps_rng_diag.entropy_calls++;
+    if (remaining == 0)
+        return ossl_rand_pool_entropy_available(pool);
+
+    rc = psInit();
+    if (rc != 0) {
+        ps_rng_diag.last_failure_stage = 1;
+        ps_rng_diag.last_ps_result = (unsigned int)rc;
+        return 0;
+    }
+
+    while (remaining != 0) {
+        const size_t amount = remaining > OSSL_3DS_PS_CHUNK
+                                  ? OSSL_3DS_PS_CHUNK : remaining;
+        unsigned char *dest = ossl_rand_pool_add_begin(pool, amount);
+
+        ps_rng_diag.last_entropy_request = (unsigned int)amount;
+        if (dest == NULL) {
+            ps_rng_diag.last_failure_stage = 3;
+            break;
+        }
+        rc = PS_GenerateRandomBytes(dest, amount);
+        if (rc != 0) {
+            ps_rng_diag.last_failure_stage = 2;
+            ps_rng_diag.last_ps_result = (unsigned int)rc;
+            OPENSSL_cleanse(dest, amount);
+            break;
+        }
+        if (!ossl_rand_pool_add_end(pool, amount, amount * 8)) {
+            ps_rng_diag.last_failure_stage = 3;
+            OPENSSL_cleanse(dest, amount);
+            break;
+        }
+        remaining -= amount;
+    }
+    psExit();
+
+    if (remaining != 0)
+        return 0;
+
+    entropy = ossl_rand_pool_entropy_available(pool);
+    if (entropy == 0)
+        ps_rng_diag.last_failure_stage = 3;
+    else
+        ps_rng_diag.entropy_successes++;
+    return entropy;
+}
+
+int ossl_pool_add_nonce_data(RAND_POOL *pool)
+{
+    unsigned char nonce[32];
+    size_t capacity = ossl_rand_pool_bytes_remaining(pool);
+    const size_t amount = capacity < sizeof(nonce) ? capacity : sizeof(nonce);
+    int added = 0;
+    Result rc;
+
+    ps_rng_diag.nonce_calls++;
+    ps_rng_diag.last_nonce_capacity = (unsigned int)capacity;
+    /* The nonce pool can be smaller than 32 bytes. Do not give OpenSSL
+     * an oversized nonce and incorrectly fail DRBG initialization. */
+    if (amount == 0) {
+        ps_rng_diag.last_failure_stage = 6;
+        return 0;
+    }
+    rc = psInit();
+    if (rc != 0) {
+        ps_rng_diag.last_failure_stage = 4;
+        ps_rng_diag.last_ps_result = (unsigned int)rc;
+        return 0;
+    }
+    rc = PS_GenerateRandomBytes(nonce, amount);
+    if (rc == 0) {
+        added = ossl_rand_pool_add(pool, nonce, amount, 0);
+        if (!added)
+            ps_rng_diag.last_failure_stage = 6;
+    } else {
+        ps_rng_diag.last_failure_stage = 5;
+        ps_rng_diag.last_ps_result = (unsigned int)rc;
+    }
+    OPENSSL_cleanse(nonce, sizeof(nonce));
+    psExit();
+    if (added)
+        ps_rng_diag.nonce_successes++;
+    return added;
+}
+
+#else /* !__3DS__ */
 #ifndef _GNU_SOURCE
 #define _GNU_SOURCE
@@ -799,5 +936,6 @@
     return time(NULL);
 }
 
 #endif /* (defined(OPENSSL_SYS_UNIX) && !defined(OPENSSL_SYS_VXWORKS)) \
