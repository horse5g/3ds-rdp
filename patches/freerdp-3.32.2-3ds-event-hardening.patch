diff --git a/winpr/libwinpr/synch/event.c b/winpr/libwinpr/synch/event.c
--- a/winpr/libwinpr/synch/event.c
+++ b/winpr/libwinpr/synch/event.c
@@ -174,6 +174,12 @@ BOOL winpr_event_set(WINPR_EVENT_IMPL* event)
 #endif
 	} while (ret < 0 && errno == EINTR);
 
+#ifdef __3DS__
+	/* SOC loopback buffer full means at least one wake token remains unread.
+	 * Treat that as signaled rather than failing SetEvent(). */
+	if ((ret < 0) && ((errno == EAGAIN) || (errno == EWOULDBLOCK)))
+		return TRUE;
+#endif
 	return ret >= 0;
 }
 
@@ -196,9 +202,14 @@ BOOL winpr_event_reset(WINPR_EVENT_IMPL* event)
 #endif
 #endif
 		} while (ret < 0 && errno == EINTR);
+#ifdef __3DS__
+		/* EOF means the loopback sender closed: don't spin on recv()==0. */
+		if (ret == 0)
+			return FALSE;
+#endif
 	} while (ret >= 0);
 
-	return (errno == EAGAIN);
+	return (errno == EAGAIN) || (errno == EWOULDBLOCK);
 }
 
 void winpr_event_uninit(WINPR_EVENT_IMPL* event)
